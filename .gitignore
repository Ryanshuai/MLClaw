# Credentials — real values live in the workspace-level resources.json,
# never in this tool repo. lifecycle/resources.json is the empty template
# and is the only copy allowed through.
secrets.json
resources.json
!lifecycle/resources.json

# Money-bearing state. These live beside resources.json in the workspace, not in this
# repo — but a stray copy here would carry instance ids and lease tokens, and the cost of
# ignoring them defensively is nothing.
leases.json
pool.json

# Python bytecode
__pycache__/
*.pyc

# pixi's solved environments. `pixi.toml` and `pixi.lock` ARE tracked — the lock
# is the point, it is what makes the env reconstructible from the repo. What must
# not be committed is the ~200-directory materialised env under it.
.pixi/

# agent-refactor's working directory (script output + state.json)
.agent-refactor/

# skill-creator's scaffolding and working directory
.claude/skills/skill-creator/
skill-creator-workspace/

# SkillOpt-Sleep's working directory (staging output + handoff intermediates,
# including the nightly-archived .doneNN variants)
.skillopt-sleep/
.skillopt-sleep-handoff/
.skillopt-sleep-handoff.night*.done/
